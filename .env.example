DATABASE_URL=postgresql://custos:custos@localhost:5433/custos_harness

# Primary "worker" role chain -- the local model that does most of the work.
LOCAL_MODEL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL_NAME=qwen2.5:7b-instruct

# Optional fallback for the worker role -- only added to the chain if
# LOCAL_FALLBACK_BASE_URL is set. E.g. a free-tier frontier model via its
# OpenAI-compatible endpoint (Gemini's /v1beta/openai, etc).
# LOCAL_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LOCAL_FALLBACK_MODEL_NAME=gemini-2.0-flash
# LOCAL_FALLBACK_API_KEY=
# LOCAL_FALLBACK_CONCURRENCY=4

# Classifier role (permission gating) -- defaults to the same as LOCAL_*
# above if unset, but every tool call pays for one of these round-trips
# (graph.py's permission_gate), so queuing it behind the worker's own
# generation is wasteful. Worth a dedicated small/fast model even on
# modest hardware -- qwen2.5:7b-instruct on a CPU-only container answered
# this deployment's classifier prompt correctly in ~6s warm, versus
# minutes queued behind a much larger worker model (2026-09-05).
# qwen2.5:3b-instruct was tried first and rejected: verified live it denied
# ~4 of 5 real cases (including a benign complete_ticket summary, mislabeled
# "touches secrets/credentials") at the same latency -- too small for this
# job. Verify a candidate classifier model against real allow/deny cases
# before trusting it; "small and fast" is not the same as "correct".
# CLASSIFIER_MODEL_BASE_URL=
# CLASSIFIER_MODEL_NAME=
# CLASSIFIER_FALLBACK_BASE_URL=

# Phase 4: turn count at which a ticket's thread gets one nudge to wrap up
# via write_handoff_note. Soft, not a hard cutoff -- unset/omitted means
# no budget at all.
# TURN_BUDGET=40

# Response-length caps per role (tokens). Caught live 2026-08-29: with no
# cap at all, a reasoning-heavy local model generated 5000+ tokens (~10 min)
# and STILL hadn't emitted its JSON verdict when killed -- a first attempt
# at REVIEWER_MAX_TOKENS=3000 confirmed reasoning alone can blow past that
# with zero actual output. Defaults baked into worker.py/scripts/run_*.py
# (8000 worker, 1000 classifier, 10000 reviewer, 4000 meta-agent/
# product-owner, 6000 overwatch) -- override per-role here if your model
# needs more or less room. Watch for "unparseable" verdicts/proposals if
# you lower any of these -- that's the symptom of a cap cutting off a
# response before its actual JSON output.
# LOCAL_MAX_TOKENS=8000
# CLASSIFIER_MAX_TOKENS=1000
# REVIEWER_MAX_TOKENS=10000
# META_AGENT_MAX_TOKENS=4000
# PRODUCT_OWNER_MAX_TOKENS=4000
# OVERWATCH_MAX_TOKENS=6000

# Per-role model overrides. A scheduled job resolves its model as
# <ROLE>_MODEL_* first, then SCHEDULER_MODEL_*, then LOCAL_MODEL_*. The
# verifier (both verify-on-close and the scheduled job) uses VERIFIER_*,
# and reflection uses REFLECTION_*. This is how you point an advisory or
# mechanical role at a cheap local model while the seats and product-owner
# stay on a frontier one -- e.g.:
#   PROGRESS_MODEL_BASE_URL=http://192.168.250.x:8080/v1
#   PROGRESS_MODEL_NAME=qwen3-8b
#   REFLECTION_MODEL_BASE_URL=http://192.168.250.x:8080/v1
#   REFLECTION_MODEL_NAME=qwen3-8b
# `progress` and `reflection` never gate anything (no merge rides on them),
# so a weaker local model there costs little. The verifier IS a gate: a
# false pass merges unverified work, so leave VERIFIER_* unset unless you
# have a concrete reason to move it.
# VERIFIER_MODEL_BASE_URL=
# VERIFIER_MODEL_NAME=
# VERIFIER_MAX_TOKENS=6000
# PROGRESS_MODEL_BASE_URL=
# PROGRESS_MODEL_NAME=
# REFLECTION_MODEL_BASE_URL=
# REFLECTION_MODEL_NAME=
# REFLECTION_MAX_TOKENS=2000

# Slack notifier (added 2026-08-29, user's own architecture ask): team-
# visible activity feed -- seat creation posts a welcome message, a
# worker starting a ticket announces it, agents can scan recent history
# for context (scan_team_channel tool). Entirely optional -- every
# slack.py function fails soft when unset, so leaving this unconfigured
# is a completely normal, fully-supported setup, not a degraded one.
# Needs a real Slack App with a BOT token (not an incoming webhook --
# reading history needs the real Web API), scopes chat:write +
# channels:history (or groups:history for a private channel), invited
# into the target channel. NOT live-verified in this session -- no
# credentials were available to test against.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL_ID=C0123456789

# Realistic agent avatars via Gemini's image generation API ("Nano
# Banana", added 2026-08-29, user's own call -- prefers this over
# DiceBear's illustrated avatars). Free tier: get a key at
# https://aistudio.google.com/apikey, no credit card required. Model
# identifier checked against Google's own docs directly (gemini-3.1-
# flash-image as of this session) -- NOT live-verified against a real
# API call, no key was available to test against. Entirely optional --
# the dashboard falls back to a DiceBear avatar (see the avatar_style
# setting above) whenever this isn't configured or a generation fails.
# GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# API auth (added 2026-08-29): a single shared bearer token gating
# every api.py endpoint except /health. Unset means auth is OFF, same
# as where the project already stood -- only safe on the docker-compose
# network / localhost. Set this before exposing the API/dashboard
# beyond that (the dashboard's own JS prompts for and stores the token
# in localStorage once the backend starts returning 401s).
# API_AUTH_TOKEN=
